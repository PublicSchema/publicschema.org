---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from '../../layouts/Base.astro';
import TranslationBanner from '../TranslationBanner.astro';
import { defaultLocale, type Locale } from '../../i18n/languages';
import { useTranslations, localePath } from '../../i18n/utils';
import { loadVocabulary } from '../../data/vocabulary';
import { createDomainCatalog } from '../../data/domains';
import { buildSystemIndex, getSystemMeta } from '../../data/systems';
import '../../styles/homepage.css';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const vocab = loadVocabulary();
const maturityOrder = ['normative', 'candidate', 'draft'];
const maturityRank: Record<string, number> = Object.fromEntries(maturityOrder.map((m, i) => [m, i]));
const byFeaturedThenMaturityThenName = (
  a: { featured: boolean; maturity: string; id: string },
  b: { featured: boolean; maturity: string; id: string },
) =>
  Number(b.featured) - Number(a.featured) ||
  (maturityRank[a.maturity] ?? 9) - (maturityRank[b.maturity] ?? 9) ||
  a.id.localeCompare(b.id);
const concepts = Object.values(vocab.concepts).sort(byFeaturedThenMaturityThenName);
const domainCatalog = createDomainCatalog(vocab, locale);

// Ids that appear in more than one domain (including root) need a domain prefix
// in chip labels to disambiguate. For example, "Person" exists at root and
// under crvs/, so the crvs/Person chip shows "crvs: Person".
const idCounts: Record<string, number> = {};
for (const c of concepts) { idCounts[c.id] = (idCounts[c.id] ?? 0) + 1; }
const chipLabel = (c: { id: string; domain?: string | null }) =>
  (idCounts[c.id] ?? 0) > 1 && c.domain ? `${c.domain}: ${c.id}` : c.id;

// One card per represented domain, core first. The core card spans the full
// width and shows every featured concept; sector cards show up to four
// featured concepts (or the first four by maturity when none are featured).
const domainCards = domainCatalog.present(concepts).map((domain) => {
  const members = concepts.filter((c) => domainCatalog.get(c.domain ?? null).value === domain.value);
  const featured = members.filter((c) => c.featured);
  const chips = domain.code
    ? (featured.length > 0 ? featured : members).slice(0, 4)
    : featured;
  const maturity = maturityOrder
    .map((level) => ({ level, count: members.filter((c) => c.maturity === level).length }))
    .filter(({ count }) => count > 0);
  return { domain, members, chips, maturity };
});

const properties = Object.values(vocab.properties);
const vocabularies = Object.values(vocab.vocabularies);
const systems = Object.keys(buildSystemIndex())
  .map((id) => ({ id, name: getSystemMeta(id).name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const modules = import.meta.glob<{ default: AstroComponentFactory }>('./content/HomepageContent.*.astro');
const wantedKey = `./content/HomepageContent.${locale}.astro`;
const fallbackKey = './content/HomepageContent.en.astro';
const loader = modules[wantedKey] ?? modules[fallbackKey];
const fellBack = !modules[wantedKey];
const Content = (await loader()).default;

const titles: Record<Locale, { title: string; description: string }> = {
  en: {
    title: 'Common definitions for public services and government registries',
    description: 'Common definitions for public services and government registries. When systems describe the same people, places, organizations and assets, they need a shared language.',
  },
  fr: {
    title: 'Définitions communes pour les services publics et les registres administratifs',
    description: 'Définitions communes pour les services publics et les registres administratifs. Lorsque des systèmes décrivent les mêmes personnes, lieux, organisations et biens, ils ont besoin d\'un langage partagé.',
  },
  es: {
    title: 'Definiciones comunes para los servicios públicos y los registros administrativos',
    description: 'Definiciones comunes para los servicios públicos y los registros administrativos. Cuando los sistemas describen a las mismas personas, lugares, organizaciones y bienes, necesitan un lenguaje compartido.',
  },
};

const { title, description } = titles[locale];
---
<Base title={title} description={description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PublicSchema",
      "url": "https://publicschema.org/",
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://publicschema.org/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PublicSchema",
      "url": "https://publicschema.org/",
      "logo": "https://publicschema.org/images/logo.png",
      "description": description
    }
  ])} />
  {fellBack && <TranslationBanner locale={locale} />}
  <Content
    locale={locale}
    conceptsCount={concepts.length}
    propertiesCount={properties.length}
    vocabulariesCount={vocabularies.length}
    systems={systems}
  >
    <div class="h3-band" id="domains" slot="domains">
      <div class="h3-band-inner">
        <h2>{t('home.domains_title')}</h2>
        <p class="h3-band-lead">{t('home.domains_lead')}</p>
        <div class="h3-domains">
          {domainCards.map(({ domain, members, chips, maturity }) => (
            <div class:list={['h3-domain', { 'h3-domain-core': !domain.code }]} style={`--domain-color: ${domain.color}`}>
              <a class="h3-domain-header" href={`${localePath('/concepts/', locale)}?domain=${encodeURIComponent(domain.value)}`}>
                <h3>{domain.code ? domain.label : t('home.domain_core')}</h3>
                <span class="h3-domain-count">{members.length}</span>
              </a>
              <p>{domain.code ? domain.description : t('home.domain_core_description')}</p>
              <div class="h3-domain-chips">
                {chips.map((c) => (
                  <a href={localePath(c.path, locale)} class="h3-chip">{chipLabel(c)}</a>
                ))}
                {members.length > chips.length && (
                  <a href={`${localePath('/concepts/', locale)}?domain=${encodeURIComponent(domain.value)}`} class="h3-chip h3-chip-more">
                    {t('home.plus_more', { count: members.length - chips.length })}
                  </a>
                )}
              </div>
              <div class="h3-domain-maturity">
                {maturity.map(({ level, count }) => (
                  <span class={`badge badge-${level}`}>{count} {t(`browse.maturity_${level}` as 'browse.maturity_draft')}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Content>

  <div class="h3-prose">
    <p class="h3-closing">
      {t('home.closing')}
      <a href="https://github.com/PublicSchema/publicschema.org">{t('home.source_github')}</a>
      <span class="h3-header-sep" aria-hidden="true"></span>
      <a href={localePath('/about/', locale)}>{t('home.about_project')}</a>
    </p>
  </div>
</Base>
